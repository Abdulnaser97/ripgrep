				},
				{
					"simStepId": "fecebcee-2687-4ad2-bd79-0604a4b8f040",
					"diagramNodeId": "dfb4c43e-3ec9-43ba-a616-bd57f6674cd8",
					"simStepLabel": "Preprocessor Search: Set preprocessor in SearchWorkerBuilder",
					"simStepDescription": "The `SearchWorkerBuilder` is configured with the preprocessor command. The path to the command is resolved to an absolute path for security reasons. This ensures that an arbitrary executable in the current directory isn't run by mistake.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "94",
						"endLine": "103",
						"relevantVariables": [
							"preprocessor",
							"grep::cli::resolve_binary(prog)",
							"self.config.preprocessor"
						]
					},
					"inputDataExample": "{\"pre_command_path\": \"pdftotext\"}",
					"outputDataExample": "{\"SearchWorkerBuilder\": {\"config\": {\"preprocessor\": \"/usr/bin/pdftotext\"}}}"
				},
				{
					"simStepId": "a1c58ae9-1849-4d4f-829e-bac1dee284a2",
					"diagramNodeId": "819d3118-b828-47c2-8db4-db53d31d4602",
					"simStepLabel": "Preprocessor Search: Pass configured SearchWorker",
					"simStepDescription": "The configured `SearchWorker` instance, with the preprocessor command set, is prepared for executing the search.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "705",
						"endLine": "705",
						"relevantVariables": [
							"builder.build(matcher, searcher, printer)"
						]
					},
					"inputDataExample": "{\"SearchWorker\": {\"config\": {\"preprocessor\": \"/usr/bin/pdftotext\"}}}",
					"outputDataExample": "{\"SearchWorker\": {\"config\": {\"preprocessor\": \"/usr/bin/pdftotext\"}}}"
				},
				{
					"simStepId": "a6afeacb-02c1-483d-acff-a916be15f12b",
					"diagramNodeId": "86edb909-6f63-4907-bb50-60f871024063",
					"simStepLabel": "Preprocessor Search: Check if file should be preprocessed",
					"simStepDescription": "For each file, the `SearchWorker` checks if it should be preprocessed. This is true if a preprocessor command is set and either no `--pre-glob` is given (meaning all files are preprocessed) or the file path matches one of the provided globs.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "283",
						"endLine": "291",
						"relevantVariables": [
							"should_preprocess",
							"self.config.preprocessor",
							"self.config.preprocessor_globs"
						]
					},
					"inputDataExample": "{\"path\": \"invoices/2023-12.pdf\"}",
					"outputDataExample": "{\"should_preprocess\": true}"
				},
				{
					"simStepId": "ecc26b7d-566e-48e3-8605-6d8157c8cfe0",
					"diagramNodeId": "86cb2db8-78ff-4673-a44f-1e65bcff3c23",
					"simStepLabel": "Preprocessor Search: Signal to preprocess file",
					"simStepDescription": "A `true` result from the check triggers the preprocessing workflow for the given file.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "283",
						"endLine": "291",
						"relevantVariables": [
							"should_preprocess"
						]
					},
					"inputDataExample": "{\"should_preprocess\": true}",
					"outputDataExample": "{\"should_preprocess\": true}"
				},
				{
					"simStepId": "93ca8f43-acd3-4f93-8b5f-d6519f91c142",
					"diagramNodeId": "7350fe65-16a7-4f96-8d68-53cd4463483e",
					"simStepLabel": "Preprocessor Search: Execute preprocessor command for the file",
					"simStepDescription": "The preprocessor command is executed as a child process. The file path is passed as an argument, and the file's contents are piped to the process's standard input.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "298",
						"endLine": "301",
						"relevantVariables": [
							"search_preprocessor",
							"bin",
							"cmd",
							"std::process::Command::new(bin)"
						]
					},
					"inputDataExample": "{\"path\": \"invoices/2023-12.pdf\", \"preprocessor\": \"/usr/bin/pdftotext\"}",
					"outputDataExample": "{\"CommandReader\": \"streaming output of 'pdftotext invoices/2023-12.pdf -'\"}"
				},
				{
					"simStepId": "f548b28d-ab54-4a7c-9535-51ef8ed4deb4",
					"diagramNodeId": "1eea7ee6-c491-4846-b4d4-6330921830f1",
					"simStepLabel": "Preprocessor Search: Stream preprocessed data",
					"simStepDescription": "The text output from the preprocessor's stdout is captured and streamed to ripgrep's searcher component.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "303",
						"endLine": "311",
						"relevantVariables": [
							"self.command_builder.build(&mut cmd)",
							"rdr"
						]
					},
					"inputDataExample": "{\"stdout_chunk\": \"Invoice #12345\\nTotal: $99.99\\n\"}",
					"outputDataExample": "{\"stdout_chunk\": \"Invoice #12345\\nTotal: $99.99\\n\"}"
				},
				{
					"simStepId": "47746894-69db-4cbd-a200-99b4c83720e4",
					"diagramNodeId": "d89113c0-1afc-40f8-935f-5818ce5ed080",
					"simStepLabel": "Preprocessor Search: Search the preprocessed stream",
					"simStepDescription": "The searcher reads the preprocessed text from the stream and applies the regex pattern to find matches. The original file path is used when printing the results.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "312",
						"endLine": "318",
						"relevantVariables": [
							"self.search_reader",
							"path",
							"rdr"
						]
					},
					"inputDataExample": "{\"preprocessed_line\": \"Invoice #12345\"}",
					"outputDataExample": "{\"match\": {\"file\": \"invoices/2023-12.pdf\", \"line\": 1, \"text\": \"Invoice #12345\"}}"
				}
			],
			"description": "<ul><li>- Search inside gzip, bzip2, xz, lz4, brotli, and zstd compressed files seamlessly with the <code>-z</code>/<code>--search-zip</code> flag</li><li>- This functionality is implemented in <code>crates/cli/decompress</li><li>rs</code> by shelling out to external decompression tools</li><li>- Define a pre-processor command with <code>--pre <CMD></code> to transform files before searching (e</li><li>g</li><li>, using <code>pdftotext</code> for PDFs), extending ripgrep's capabilities to any text-convertible format</li><li>- The <code>SearchWorker</code> in <code>crates/core/search</li><li>rs</code> orchestrates whether to decompress, preprocess, or read a file directly</li></ul>",
			"simulationNodesAndEdges": {
