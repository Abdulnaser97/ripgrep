					"inputDataExample": "{\n  \"type_changes\": [\n    {\n      \"type\": \"Add\",\n      \"def\": \"rust:*.rs\"\n    },\n    {\n      \"type\": \"Select\",\n      \"name\": \"rust\"\n    },\n    {\n      \"type\": \"Negate\",\n      \"name\": \"toml\"\n    }\n  ]\n}",
					"outputDataExample": "{\n  \"types_builder\": \"Contains definitions for 'rust', 'toml', etc., and selections for 'rust' (include) and 'toml' (exclude)\"\n}"
				},
				{
					"simStepId": "d356c6e2-8e97-451e-8513-0bd524e26db4",
