					"simStepLabel": "Finalize Types Matcher",
					"simStepDescription": "After all user configurations are applied, the `TypesBuilder::build` method is called to finalize the matcher.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "1199",
						"endLine": "1199",
						"relevantVariables": [
							"builder.build()"
