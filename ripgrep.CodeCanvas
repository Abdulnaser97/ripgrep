							"self.builder.build()"
						]
					},
					"inputDataExample": "{\n  \"globset_builder\": \"contains globs for [*.rs, !src/main.rs]\"\n}",
					"outputDataExample": "{\n  \"override_matcher\": \"ignore::overrides::Override\"\n}"
				},
				{
					"simStepId": "31c3ff94-6416-420f-be54-9de852fca0bf",
					"diagramNodeId": "896e330b-cfc6-4374-a7b1-657d1d934deb",
					"simStepLabel": "Process File Type Arguments",
					"simStepDescription": "With the glob overrides built, the `HiArgs` constructor proceeds to build the file type matcher by passing the collected `type_changes` to the `types` helper function.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "149",
						"endLine": "149",
						"relevantVariables": [
