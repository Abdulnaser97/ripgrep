					"simStepLabel": "Compressed File Search: Signal to decompress file",
					"simStepDescription": "The boolean result from the check determines whether the file will be passed to a decompressor or read directly. A `true` value triggers the decompression workflow.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "275",
