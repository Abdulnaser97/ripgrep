					"inputDataExample": "{\"bytes\": \"/// A searcher executes searches over a haystack and writes results to a caller\", \"line_number\": 602, \"absolute_byte_offset\": 21350}",
					"outputDataExample": "{\"formatted_string\": \"crates/searcher/src/searcher/mod.rs:602:/// A searcher executes searches over a haystack and writes results to a caller\"}"
				},
				{
					"simStepId": "19d357b3-8e9b-4af5-a091-c987d64461c9",
					"diagramNodeId": "b4dcec36-61e7-490b-bafc-73b42d9bd58c",
					"simStepLabel": "Write Formatted Line to Buffer",
					"simStepDescription": "The formatted string is written from the `StandardSink` into a thread-local buffer. This buffer accumulates results from a single worker thread before being flushed to the main output stream.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/printer/src/standard.rs",
						"startLine": "1192",
						"endLine": "1200",
						"relevantVariables": [
