							"searcher.search(&haystack)"
						]
					},
					"inputDataExample": "{\"path\": \"crates/searcher/src/searcher/mod.rs\", \"file_type\": \"file\"}",
					"outputDataExample": "{\"path\": \"crates/searcher/src/searcher/mod.rs\", \"status\": \"Search initiated\"}"
				},
				{
					"simStepId": "c3d5c692-3e98-4504-b8b1-3703956760cf",
					"diagramNodeId": "9fb3ce61-9f81-406c-9731-2cb3ff818751",
					"simStepLabel": "Dispatch to Searcher Core",
					"simStepDescription": "The `SearchWorker` determines the appropriate search strategy (e.g., direct file search, decompression, preprocessor). For a standard file, it dispatches the search task to the underlying `grep::searcher::Searcher`, passing the matcher, file path, and a printer sink.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "344",
						"endLine": "344",
						"relevantVariables": [
							"search_path",
							"matcher",
							"searcher",
							"printer",
							"path"
						]
					},
					"inputDataExample": "{\"haystack\": {\"path\": \"crates/searcher/src/searcher/mod.rs\"}}",
					"outputDataExample": "{\"path\": \"crates/searcher/src/searcher/mod.rs\", \"matcher\": \"PatternMatcher::RustRegex\", \"printer\": \"Printer::Standard\"}"
				},
				{
					"simStepId": "45cec2f1-4626-4c94-bdc5-b335e5b79737",
					"diagramNodeId": "1ae07df4-0afc-4b84-8509-d192b67a02b7",
					"simStepLabel": "Execute Line-by-Line Search",
					"simStepDescription": "The `grep_searcher::Searcher` reads the file content. It employs a line-by-line search strategy, reading chunks of the file into a buffer. It iterates through each line in the buffer, applying the regex `Matcher` to find matching lines.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/glue.rs",
						"startLine": "39",
						"endLine": "55",
