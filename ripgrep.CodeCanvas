					"inputDataExample": "{\"SinkMatch\": {\"bytes\": \"...Doctor Watson...\", \"line_number\": 5, \"absolute_byte_offset\": 258, \"matches\": [{\"start\": 11, \"end\": 17}]}}",
					"outputDataExample": "{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"sherlock.txt\"},\"lines\":{\"text\":\"but Doctor Watson...\\n\"},\"line_number\":5,\"absolute_offset\":258,\"submatches\":[{\"match\":{\"text\":\"Watson\"},\"start\":11,\"end\":17}]}}"
				},
				{
					"simStepId": "e0dee126-27b6-4bf2-be62-8c5cb2e2bdc6",
