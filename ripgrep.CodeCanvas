							"sink",
							"write_prelude",
							"write_line_number",
							"write_column",
							"write_context_separator"
						]
					},
					"inputDataExample": "{\"SinkMatch\": {\"bytes\": \"For the Doctor Watsons of this world...\\n\", \"line_number\": 1, \"matches\":[{\"start\":15, \"end\":21}]}}",
					"outputDataExample": "{\"formatted_line\": \"1:16:For the Doctor Watsons of this world...\\n\"}"
				},
				{
					"simStepId": "6657886e-26ea-4991-95ed-deb42a2defce",
					"diagramNodeId": "87dcc549-2a4f-4962-a82c-435e36134495",
					"simStepLabel": "Flow 1 - Standard Output: Write Formatted Text to stdout",
