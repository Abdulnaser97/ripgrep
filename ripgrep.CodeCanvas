							"haystack",
							"self.find_at"
						]
					},
					"inputDataExample": "{\"haystack_utf8\": \"Sherlock\"}",
					"outputDataExample": "{\"match\": {\"start\": 0, \"end\": 8}}"
				}
			],
			"description": "<ul><li>- Supports searching files in text encodings other than UTF-8, such as UTF-16, latin-1, and more</li><li>- Automatically detects and handles UTF-16 byte order marks (BOMs) by transcoding the file to UTF-8 before searching</li><li>- Manually specify an encoding for all files using the <code>-E</code>/<code>--encoding</code> flag</li><li>- This ensures correct matching in codebases with mixed or legacy file encodings</li></ul>",
