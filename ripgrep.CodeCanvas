					"inputDataExample": "{\"line_content\": \"A searcher executes searches over a haystack and writes results to a caller\", \"line_number\": 602, \"match_found\": true}",
					"outputDataExample": "{\"bytes\": \"/// A searcher executes searches over a haystack and writes results to a caller\", \"line_number\": 602, \"absolute_byte_offset\": 21350}"
				},
				{
					"simStepId": "2d60efc6-662a-44d2-8119-952b3086d6d4",
					"diagramNodeId": "5f11addd-cb94-4f31-832b-46065a8dfc6f",
					"simStepLabel": "Format Matched Line for Output",
					"simStepDescription": "The `StandardSink` receives the `SinkMatch` object. It formats the output string by adding the file path, line number, and applying color highlighting to the matched text according to the user's configuration.",
