					"inputDataExample": "{\"output_string\": \"1:16:For the Doctor Watsons...\\n2-Holmeses, success...\\n--\\n\"}",
					"outputDataExample": "{\"output_string\": \"1:16:For the Doctor Watsons...\\n2-Holmeses, success...\\n--\\n\"}"
				},
				{
					"simStepId": "0bf34798-9586-4200-8372-916999070ba2",
					"diagramNodeId": "6e81146c-872e-4c4c-803e-0baaece5085f",
					"simStepLabel": "Flow 2 - JSON Output: Parse JSON Flag",
					"simStepDescription": "The application is started with the `--json` flag. The argument parser recognizes this flag and sets the application's search mode to `JSON` within the `LowArgs` configuration struct.",
					"isEdge": 0,
