					},
					"inputDataExample": "{\"formatted_string\": \"crates/searcher/src/searcher/mod.rs:602:/// A searcher executes searches over a haystack and writes results to a caller\"}",
					"outputDataExample": "{\"formatted_string\": \"crates/searcher/src/searcher/mod.rs:602:/// A searcher executes searches over a haystack and writes results to a caller\"}"
				},
				{
					"simStepId": "58fe133a-d724-448e-ac44-cfd3a3de05c3",
					"diagramNodeId": "8551ceba-1b32-46e2-b8bf-bb30f8d4a919",
					"simStepLabel": "Print Buffered Output to Console",
					"simStepDescription": "After a worker thread finishes searching a file, it acquires a lock on the main output writer (stdout) and prints the contents of its local buffer. This approach ensures that output from different files remains contiguous and is not interleaved.",
					"isEdge": 0,
