		"Search within compressed files and use preprocessors for custom formats": {
			"name": "Search within compressed files and use preprocessors for custom formats",
			"simSteps": [
				{
					"simStepId": "c29476dd-d067-4661-be7e-e18c3e7ba67b",
					"diagramNodeId": "6950d682-71a7-4969-af34-b22455c841b5",
					"simStepLabel": "Compressed File Search: Parse -z/--search-zip flag",
					"simStepDescription": "The command-line arguments are parsed. When the `-z` or `--search-zip` flag is present, it's identified and stored in the configuration for later use. This flag signals that ripgrep should attempt to decompress files before searching them.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/defs.rs",
						"startLine": "6062",
						"endLine": "6081",
						"relevantVariables": [
							"SearchZip",
							"name_short",
							"name_long"
						]
					},
					"inputDataExample": "{\"argv\": [\"rg\", \"-z\", \"Sherlock\", \"sherlock.gz\"]}",
					"outputDataExample": "{\"LowArgs\": {\"search_zip\": true}}"
				},
				{
					"simStepId": "4083ea4d-062d-4897-8fad-f1ad1b4ebc26",
					"diagramNodeId": "e610fcdb-7b3d-4c76-a5a7-bf2a9a036842",
					"simStepLabel": "Compressed File Search: Transmit Parsed Arguments",
					"simStepDescription": "The parsed flag `search_zip: true` is passed internally as part of the low-level application arguments, which will be used to configure the search behavior.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "702",
						"endLine": "702",
						"relevantVariables": [
							"self.search_zip"
						]
					},
					"inputDataExample": "{\"LowArgs\": {\"search_zip\": true}}",
					"outputDataExample": "{\"LowArgs\": {\"search_zip\": true}}"
				},
				{
					"simStepId": "03cde253-45d7-4216-b089-825d6fce5ec3",
					"diagramNodeId": "5e7f3e2a-3045-4c34-9557-d2da69c2bfbd",
					"simStepLabel": "Compressed File Search: Configure SearchWorkerBuilder for decompression",
					"simStepDescription": "The `SearchWorkerBuilder` is configured based on the parsed arguments. The `search_zip` method is called to enable the decompression feature in the search worker's configuration.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/search.rs",
						"startLine": "119",
						"endLine": "125",
						"relevantVariables": [
							"search_zip",
							"self.config.search_zip"
						]
					},
					"inputDataExample": "{\"LowArgs\": {\"search_zip\": true}}",
					"outputDataExample": "{\"SearchWorkerBuilder\": {\"config\": {\"search_zip\": true}}}"
				},
				{
					"simStepId": "1a8296ec-9bfa-4445-9bf1-4ed59a570087",
					"diagramNodeId": "649d1671-efd9-4933-94b7-c80ec8f8f603",
					"simStepLabel": "Compressed File Search: Pass configured SearchWorker",
					"simStepDescription": "The configured `SearchWorker` instance, with decompression enabled, is prepared for executing the search over the filesystem.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "705",
						"endLine": "705",
						"relevantVariables": [
							"builder.build(matcher, searcher, printer)"
						]
					},
					"inputDataExample": "{\"SearchWorker\": {\"config\": {\"search_zip\": true}}}",
					"outputDataExample": "{\"SearchWorker\": {\"config\": {\"search_zip\": true}}}"
				},
				{
					"simStepId": "62181f2a-eced-4924-abc4-e51841f7335c",
					"diagramNodeId": "f2367165-3be5-454c-beec-9c4c3f19aeaa",
					"simStepLabel": "Compressed File Search: Check if file path matches a decompression rule",
					"simStepDescription": "For each file found, the `SearchWorker` checks if it should be decompressed. This is done by the `DecompressionMatcher`, which checks the file path against a set of globs associated with known decompression commands (e.g., `*.gz` for `gzip`).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/cli/src/decompress.rs",
						"startLine": "191",
						"endLine": "193",
						"relevantVariables": [
