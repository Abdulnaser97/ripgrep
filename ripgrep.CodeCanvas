						]
					},
					"inputDataExample": "{\"replacement_template\": \"item: $2, user: $1\", \"captures\": {\"groups\": [{\"text\": \"ticket-123\"}, {\"text\": \"ticket\"}, {\"text\": \"123\"}]}}",
					"outputDataExample": "{\"interpolated_bytes\": \"item: 123, user: ticket\"}"
