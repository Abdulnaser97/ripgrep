					"inputDataExample": "{\n  \"selections\": [\n    \"rust\",\n    \"!toml\"\n  ],\n  \"definitions\": {\n    \"rust\": [\"*.rs\"],\n    \"toml\": [\"*.toml\"]\n  }\n}",
					"outputDataExample": "{\n  \"types_matcher\": {\n    \"glob_set\": \"Compiled from [*.rs, *.toml]\",\n    \"selections\": \"Mapping of glob matches back to 'rust' or 'toml' selections\"\n  }\n}"
				},
				{
					"simStepId": "13500c0e-aac3-4ded-9289-d7ed7d2d09b0",
					"diagramNodeId": "752bf5ed-35cd-4781-ad19-3c05f57b97ba",
					"simStepLabel": "Configure Directory Walker",
					"simStepDescription": "The fully constructed `HiArgs` object, containing both the `Override` and `Types` matchers, is used to configure a `WalkBuilder` for directory traversal. This transfers the filtering logic to the component responsible for finding files.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "887",
