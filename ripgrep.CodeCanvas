					},
					"inputDataExample": "{\"argv\": [\"rg\", \"--pre\", \"pdftotext\", \"--pre-glob\", \"*.pdf\", \"pattern\", \"doc.pdf\"]}",
					"outputDataExample": "{\"LowArgs\": {\"pre\": \"pdftotext\", \"pre_glob\": [\"*.pdf\"]}}"
				},
				{
					"simStepId": "0c16b679-fb65-4ba2-8122-0f8587bed00d",
					"diagramNodeId": "d66acde4-7c31-485a-ad90-d307e992c854",
					"simStepLabel": "Preprocessor Search: Transmit Parsed Arguments",
					"simStepDescription": "The parsed preprocessor command and associated globs are passed internally as arguments to configure the search worker.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "700",
