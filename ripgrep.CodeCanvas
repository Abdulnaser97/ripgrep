							"build_parallel()",
							"run()"
						]
					},
					"inputDataExample": "{\"pattern\": \"Matcher\", \"path\": \"crates/\", \"threads\": 8}",
					"outputDataExample": "{\"status\": \"ParallelWalker initialized and running\"}"
				},
				{
					"simStepId": "6e04f3ee-cf2e-4bf2-9a6d-4214a7a374c0",
					"diagramNodeId": "85096c21-9d43-4a81-ac77-7ca2190cb90b",
					"simStepLabel": "Distribute File Path to Worker",
					"simStepDescription": "The parallel directory walker discovers a file that is not ignored. It sends the directory entry as a work item to an available worker thread in the pool.",
					"isEdge": 1,
					"sourceCodeMapping": {
