					"diagramNodeId": "83a26f9f-eeeb-45b2-b930-b4e4f8fcbdbc",
					"simStepLabel": "Worker Thread Prepares Search",
					"simStepDescription": "A worker thread receives a file path from the directory walker. It encapsulates this path into a 'Haystack' object and invokes the `search` method on its cloned `SearchWorker` instance to begin the search process for that specific file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/main.rs",
						"startLine": "186",
						"endLine": "194",
						"relevantVariables": [
