						]
					},
					"inputDataExample": "{\n  \"hi_args\": {\n    \"globs\": \"Override matcher\",\n    \"types\": \"Types matcher\"\n  }\n}",
					"outputDataExample": "{\n  \"hi_args\": {\n    \"globs\": \"Override matcher\",\n    \"types\": \"Types matcher\"\n  }\n}"
				},
				{
					"simStepId": "630716f8-5ac5-4a7d-add4-8397d5a75ed4",
					"diagramNodeId": "c3641066-8c5c-46ed-a6aa-de328dd7eb77",
					"simStepLabel": "Begin Directory Traversal",
					"simStepDescription": "The directory walker starts traversing files and directories. For each entry found, it consults a combined `Ignore` matcher to determine if the entry should be included in the search.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/dir.rs",
						"startLine": "375",
						"endLine": "376",
						"relevantVariables": [
							"Ignore::matched"
						]
					},
					"inputDataExample": "{\n  \"dir_entry\": \"src/lib.rs\"\n}",
					"outputDataExample": "{\n  \"dir_entry\": \"src/lib.rs\",\n  \"is_dir\": false\n}"
				},
				{
					"simStepId": "844cc506-cb15-46b2-91a9-d48983b0275b",
					"diagramNodeId": "fae9326f-561f-4440-917a-76709f63cc4b",
					"simStepLabel": "Path Sent for Matching",
					"simStepDescription": "The file path of the current directory entry is passed to the core matching logic, which applies filters in order of precedence.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/dir.rs",
						"startLine": "384",
						"endLine": "391",
						"relevantVariables": [
							"self.0.overrides.matched"
						]
					},
					"inputDataExample": "{\n  \"path\": \"src/lib.rs\",\n  \"is_dir\": false\n}",
					"outputDataExample": "{\n  \"path\": \"src/lib.rs\",\n  \"is_dir\": false\n}"
				},
				{
					"simStepId": "8b70ea48-d1ad-43d2-99dd-f518f1d769a0",
					"diagramNodeId": "a5d8b375-2488-4f96-aab2-7d8c385d79b4",
					"simStepLabel": "Apply High-Precedence Override Filter",
					"simStepDescription": "The first filter applied is the `Override` matcher built from `--glob` flags. If a file path matches any glob in this set, a definitive decision (either `Whitelist` or `Ignore`) is made immediately, and no further filters are checked for this file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/overrides.rs",
						"startLine": "104",
						"endLine": "112",
						"relevantVariables": [
							"Override::matched",
							"self.0.matched(path, is_dir).invert()"
						]
					},
					"inputDataExample": "{\n  \"path\": \"src/main.rs\",\n  \"is_dir\": false\n}",
					"outputDataExample": "{\n  \"match_result\": \"Ignore(Glob for '!src/main.rs')\"\n}"
				},
				{
					"simStepId": "55684897-6e03-479f-9a3f-8820d4d6e965",
					"diagramNodeId": "8251023d-5d41-4ade-967c-827bb2260b58",
					"simStepLabel": "Path Sent for Type Matching",
					"simStepDescription": "If the override filter did not match the path, the matching logic proceeds to the next filter: file types. The path is passed to the `Types` matcher.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/dir.rs",
						"startLine": "402",
						"endLine": "403",
						"relevantVariables": [
							"self.0.types.matched"
						]
					},
					"inputDataExample": "{\n  \"path\": \"src/lib.rs\",\n  \"is_dir\": false\n}",
					"outputDataExample": "{\n  \"path\": \"src/lib.rs\",\n  \"is_dir\": false\n}"
				},
				{
					"simStepId": "11c00d82-e36d-45fd-b0d7-3faa1fa51041",
					"diagramNodeId": "7bdae677-921a-4912-a2ac-cbac8532d23a",
					"simStepLabel": "Apply File Type Filter",
					"simStepDescription": "The `Types::matched` function extracts just the file name from the path (e.g., `lib.rs`). It then checks this name against its internal `GlobSet`. Based on whether the matching glob belongs to a whitelisted (`-t`) or blacklisted (`-T`) type, it returns an appropriate match result.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/types.rs",
						"startLine": "261",
						"endLine": "299",
						"relevantVariables": [
							"Types::matched",
							"file_name",
							"self.set.matches_into",
							"sel.is_negated()",
							"Match::Whitelist",
							"Match::Ignore"
						]
					},
					"inputDataExample": "{\n  \"path_name\": \"lib.rs\",\n  \"is_dir\": false\n}",
					"outputDataExample": "{\n  \"match_result\": \"Whitelist(Glob for type 'rust')\"\n}"
				},
				{
					"simStepId": "b0195d65-34f3-41c2-8e52-95658a7345f9",
					"diagramNodeId": "7b0048d0-45b3-493e-8a50-cc63f340fcf4",
					"simStepLabel": "Final Filtering Decision",
					"simStepDescription": "The match result from the `Types` filter (and potentially other lower-precedence filters like `.gitignore`) is propagated back to the directory walker.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/walk.rs",
						"startLine": "451",
						"endLine": "479",
						"relevantVariables": [
							"WalkBuilder"
						]
					},
					"inputDataExample": "{\n  \"match_result\": \"Whitelist(Glob for type 'rust')\"\n}",
					"outputDataExample": "{\n  \"match_result\": \"Whitelist(Glob for type 'rust')\"\n}"
				},
				{
					"simStepId": "bf776a19-6bae-4046-95ea-13b541e5f5e2",
					"diagramNodeId": "326ad82c-48cd-4347-950f-22b130f8e5e6",
					"simStepLabel": "Include or Exclude File from Search",
					"simStepDescription": "The directory walker uses the final match decision. If the file is whitelisted or not ignored by any filter, it is yielded as an entry to be searched. If it is ignored, it is skipped, and the walker moves to the next file.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/ignore/src/walk.rs",
						"startLine": "226",
						"endLine": "236",
						"relevantVariables": [
							"WalkState::next",
							"self.ignore_match(dent)",
							"mat.is_ignore()"
						]
					},
					"inputDataExample": "{\n  \"path\": \"src/lib.rs\",\n  \"match_result\": \"Whitelist(Glob for type 'rust')\"\n}",
					"outputDataExample": "{\n  \"action\": \"Yield DirEntry for 'src/lib.rs' to be searched\"\n}"
				}
			],
			"description": "<ul><li>- Use the <code>-g</code>/<code>--glob</code> flag to specify glob patterns for files to include or exclude (e</li><li>g</li><li>, <code>-g '<em></li><li>rs'</code> or <code>-g '!</em></li><li>md'</code>)</li><li>- Use the <code>-t</code>/<code>--type</code> and <code>-T</code>/<code>--type-not</code> flags to filter by pre-defined or custom file types (e</li><li>g</li><li>, <code>-trust</code>, <code>-Tjs</code>)</li><li>- Custom types can be defined on the fly with <code>--type-add</code> or in a configuration file</li><li>- Implemented using <code>Override</code> builders in the <code>ignore</code> crate to apply ad-hoc filtering rules</li></ul>",
