							"self.core.match_by_line(buf)"
						]
					},
					"inputDataExample": "{\"path\": \"crates/searcher/src/searcher/mod.rs\", \"matcher\": \"PatternMatcher::RustRegex\", \"printer\": \"Printer::Standard\"}",
					"outputDataExample": "{\"line_content\": \"A searcher executes searches over a haystack and writes results to a caller\", \"line_number\": 602, \"match_found\": true}"
				},
				{
					"simStepId": "3a31188c-55b1-457d-b045-74d11700fb85",
					"diagramNodeId": "82f265f8-7b1f-44cf-bfbd-ee35faf26464",
					"simStepLabel": "Send Match to Sink",
					"simStepDescription": "When the `Matcher` confirms a match on a line, the searcher core packages the relevant information—including the line content, line number, and byte offset—into a `SinkMatch` object. This object is then passed to the configured sink (the printer) for processing.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/core.rs",
						"startLine": "529",
						"endLine": "537",
						"relevantVariables": [
