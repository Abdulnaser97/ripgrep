					"outputDataExample": "{\"HiArgs\": {\"mode\": \"Search(JSON)\"}}"
				},
				{
					"simStepId": "c587fa94-e164-4f06-a7b3-c8794944667e",
					"diagramNodeId": "33cc7b78-df88-4d09-8f65-a10685c61434",
					"simStepLabel": "Flow 2 - JSON Output: Select and Build JSON Printer",
					"simStepDescription": "The `HiArgs::printer` method checks the search mode. Since it's `SearchMode::JSON`, it calls `HiArgs::printer_json`. This method then uses `JSONBuilder` to construct a `JSON` printer instance, which will format output as JSON Lines.",
					"isEdge": 0,
					"sourceCodeMapping": {
