					"simStepLabel": "Flow 2 - JSON Output: Write JSON Line to stdout",
					"simStepDescription": "Each serialized JSON message for `begin`, `match`, and `context` events is written as a single line to the standard output stream, adhering to the JSON Lines format.",
					"isEdge": 1,
