					"diagramNodeId": "df602689-8a7a-482d-9af0-5b7dea47b7af",
					"simStepLabel": "Flow 2 - JSON Output: Format 'end' JSON Message",
					"simStepDescription": "Once the search of a file is complete, the `JSONSink`'s `finish` method is called. It constructs and serializes a final `end` message, which includes the file path and comprehensive summary statistics like elapsed time, total matches, and bytes searched.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/printer/src/json.rs",
						"startLine": "665",
						"endLine": "684",
						"relevantVariables": [
							"JSONSink",
							"finish",
							"jsont::Message::End"
						]
					},
					"inputDataExample": "{\"stats\": {\"matches\": 4, \"matched_lines\": 3, \"bytes_searched\": 418}}",
					"outputDataExample": "{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"sherlock.txt\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":12345,\"human\":\"...\"},\"searches\":1,\"searches_with_match\":1,\"bytes_searched\":418,\"bytes_printed\":...}}"
				},
				{
					"simStepId": "3e5d6701-2f59-44c0-b928-99a95f0a22f9",
					"diagramNodeId": "",
					"simStepLabel": "Flow 2 - JSON Output: Write Final JSON Line to stdout",
					"simStepDescription": "The final serialized `end` message is written as a single line to the standard output, concluding the JSON stream for that particular file search.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/printer/src/json.rs",
						"startLine": "864",
						"endLine": "876",
						"relevantVariables": [
							"JSON",
							"write_message"
						]
					},
					"inputDataExample": "{\"json_string\": \"{\\\"type\\\":\\\"end\\\",\\\"data\\\":{...}}\\n\"}",
					"outputDataExample": "{\"json_string\": \"{\\\"type\\\":\\\"end\\\",\\\"data\\\":{...}}\\n\"}"
				}
			],
			"description": "<ul><li>- Display contextual lines around matches with <code>-A</code> (after), <code>-B</code> (before), and <code>-C</code> (context) flags</li><li>- Show line numbers (<code>-n</code>) and column numbers (<code>--column</code>) for each match to easily locate results</li><li>- Output results in a machine-readable JSON Lines format using <code>--json</code> for integration with other tools and scripts</li><li>- This functionality is handled by different <code>Printer</code> implementations (<code>Standard</code>, <code>JSON</code>, <code>Summary</code>) in the <code>crates/printer</code> crate</li></ul>",
