					},
					"inputDataExample": "{\n  \"type_changes\": [\n    {\n      \"type\": \"Add\",\n      \"def\": \"rust:*.rs\"\n    },\n    {\n      \"type\": \"Select\",\n      \"name\": \"rust\"\n    },\n    {\n      \"type\": \"Negate\",\n      \"name\": \"toml\"\n    }\n  ]\n}",
					"outputDataExample": "{\n  \"type_changes\": [\n    {\n      \"type\": \"Add\",\n      \"def\": \"rust:*.rs\"\n    },\n    {\n      \"type\": \"Select\",\n      \"name\": \"rust\"\n    },\n    {\n      \"type\": \"Negate\",\n      \"name\": \"toml\"\n    }\n  ]\n}"
				},
				{
					"simStepId": "0464bbb0-b454-405b-a324-4369cf40ec88",
					"diagramNodeId": "b9a26826-880c-4aae-a625-a90ec028fe51",
					"simStepLabel": "Build File Type Matcher",
					"simStepDescription": "The `types` function initializes an `ignore::types::TypesBuilder`, adds default file type definitions, and then iterates through the user's type changes. It calls `add_def` for `--type-add`, `select` for `-t`, and `negate` for `-T` to configure the builder.",
					"isEdge": 0,
					"sourceCodeMapping": {
