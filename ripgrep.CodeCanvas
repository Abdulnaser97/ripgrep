					},
					"inputDataExample": "{\"SinkMatch\": {\"bytes\": \"...Doctor Watson...\", \"line_number\": 5, \"absolute_byte_offset\": 258, \"matches\": [{\"start\": 11, \"end\": 17}]}}",
					"outputDataExample": "{\"SinkMatch\": {\"bytes\": \"...Doctor Watson...\", \"line_number\": 5, \"absolute_byte_offset\": 258, \"matches\": [{\"start\": 11, \"end\": 17}]}}"
				},
				{
					"simStepId": "a65ca555-1efc-4aa6-9981-0bee62fd0660",
					"diagramNodeId": "2eab1465-119d-480b-bae1-17b028327783",
					"simStepLabel": "Flow 2 - JSON Output: Format 'match' and 'context' JSON Messages",
					"simStepDescription": "The `JSONSink` receives data for each match or context line and serializes it into a JSON object according to the defined format. Each object is tagged with a `type` (`match` or `context`) and contains a `data` payload with details like the file path, line content (base64 encoded if not UTF-8), line number, and submatch offsets.",
					"isEdge": 0,
					"sourceCodeMapping": {
