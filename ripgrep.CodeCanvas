		"Search files with various text encodings": {
			"name": "Search files with various text encodings",
			"simSteps": [
				{
					"simStepId": "b6a40cb7-9840-46d5-94bc-88c1871975e8",
					"diagramNodeId": "6d246d4e-62ee-405d-8b63-811f90b00d88",
					"simStepLabel": "Parse Encoding Flag",
					"simStepDescription": "The application parses command-line arguments, specifically handling the `-E` or `--encoding` flag. This flag allows the user to specify a text encoding for the files being searched, such as `utf-16le`, or use special values like `auto` (default) for BOM sniffing or `none` to disable transcoding.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/defs.rs",
						"startLine": "1639",
						"endLine": "1647",
						"relevantVariables": [
							"v",
							"args",
							"value",
							"label",
							"args.encoding",
							"EncodingMode",
							"grep::searcher::Encoding::new(label)"
						]
					},
					"inputDataExample": "{\"args\": [\"rg\", \"-E\", \"utf-16le\", \"Sherlock\", \"sherlock_utf16.txt\"]}",
					"outputDataExample": "{\"encoding_mode\": \"Some('utf-16le')\"}"
				},
				{
					"simStepId": "119d90d7-b49f-4d30-b31e-5b4457e67da0",
					"diagramNodeId": "5ac2827e-c8b1-4d79-8e9f-771e7da3c58f",
					"simStepLabel": "Transmit Parsed Encoding Mode",
					"simStepDescription": "The parsed encoding mode, represented by the `EncodingMode` enum, is passed from the low-level argument parsing logic to the higher-level argument structure (`HiArgs`) for further processing.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "266",
						"endLine": "266",
						"relevantVariables": [
							"low.encoding"
						]
					},
					"inputDataExample": "{\"encoding_mode\": \"Some('utf-16le')\"}",
					"outputDataExample": "{\"encoding_mode\": \"Some('utf-16le')\"}"
				},
				{
					"simStepId": "8ee1c9df-6396-4e12-ae68-36d37af17522",
					"diagramNodeId": "a7912183-942d-4ef1-8193-19ca96a33723",
					"simStepLabel": "Configure Searcher with Encoding",
					"simStepDescription": "The high-level arguments are used to configure a `SearcherBuilder`. The `EncodingMode` determines how the searcher will handle text encodings. If a specific encoding is provided, it's set on the builder. If `Disabled` is selected, BOM sniffing is turned off. The default `Auto` mode relies on BOM sniffing.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "738",
						"endLine": "745",
						"relevantVariables": [
							"self.encoding",
							"EncodingMode",
							"builder",
							"builder.encoding(Some(enc.clone()))",
							"builder.bom_sniffing(false)"
						]
					},
					"inputDataExample": "{\"encoding_mode\": \"Some(Encoding('utf-16le'))\"}",
					"outputDataExample": "{\"searcher_builder_config\": {\"encoding\": \"utf-16le\", \"bom_sniffing\": true}}"
				},
				{
					"simStepId": "d71c84b6-60fd-4a58-b7fe-8dcfd4befdde",
					"diagramNodeId": "62e31db8-ab01-4033-bd81-484c75e6805a",
					"simStepLabel": "Transmit Searcher Configuration",
					"simStepDescription": "The configured `SearcherBuilder` instance is used to create the final `Searcher`. This step represents the transition from configuration to the actual search machinery.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/hiargs.rs",
						"startLine": "746",
						"endLine": "746",
						"relevantVariables": [
							"builder.build()"
						]
					},
					"inputDataExample": "{\"searcher_builder_config\": {\"encoding\": \"utf-16le\", \"bom_sniffing\": true}}",
					"outputDataExample": "{\"searcher_builder_config\": {\"encoding\": \"utf-16le\", \"bom_sniffing\": true}}"
				},
				{
					"simStepId": "4461b461-2591-45e6-932f-6e9b650a307b",
					"diagramNodeId": "c7494dfa-baaa-4fa5-bd1e-8cbfd6ac22d6",
					"simStepLabel": "Initialize Transcoding Reader",
					"simStepDescription": "When the `Searcher` is built, it initializes a `DecodeReaderBytesBuilder`. This builder is configured based on the encoding settings (explicit encoding, BOM sniffing). It's responsible for creating a streaming reader that will transcode file contents to UTF-8 on the fly.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/mod.rs",
						"startLine": "323",
						"endLine": "328",
						"relevantVariables": [
							"decode_builder",
							"DecodeReaderBytesBuilder",
							"self.config.encoding",
							"self.config.bom_sniffing"
						]
					},
					"inputDataExample": "{\"config\": {\"encoding\": \"Some(Encoding('utf-16le'))\", \"bom_sniffing\": true}}",
					"outputDataExample": "{\"decode_builder\": {\"encoding\": \"utf-16le\", \"strip_bom\": true, \"bom_sniffing\": true}}"
				},
				{
					"simStepId": "792c24e2-7b7e-44e4-bc1f-c7caeb1b3c05",
					"diagramNodeId": "93b18460-293e-4e8b-9423-a869f384e22f",
					"simStepLabel": "Transmit Raw File Bytes",
					"simStepDescription": "During the search, raw bytes from a file are read and passed to the searcher's internal methods. This data may be in any encoding, such as UTF-16LE with a BOM.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/mod.rs",
						"startLine": "785",
						"endLine": "785",
						"relevantVariables": [
							"slice",
							"self.search_reader",
							"matcher",
							"write_to"
						]
					},
					"inputDataExample": "{\"file_bytes\": \"[255, 254, 83, 0, 104, 0, 101, 0, 114, 0, 108, 0, 111, 0, 99, 0, 107, 0]\"}",
					"outputDataExample": "{\"file_bytes\": \"[255, 254, 83, 0, 104, 0, 101, 0, 114, 0, 108, 0, 111, 0, 99, 0, 107, 0]\"}"
				},
				{
					"simStepId": "f4dd4a98-1feb-4b88-b69a-c12509fac076",
					"diagramNodeId": "4e62b922-2b01-4a1e-afdc-73119a26653e",
					"simStepLabel": "Detect BOM and Need for Transcoding",
					"simStepDescription": "Before searching a slice of bytes directly, the searcher checks if transcoding is necessary. This is true if an encoding was manually specified or if BOM sniffing is enabled and a UTF-8 or UTF-16 BOM is detected at the start of the data.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/mod.rs",
						"startLine": "1032",
						"endLine": "1041",
						"relevantVariables": [
							"slice_has_bom",
							"slice",
							"encoding_rs::Encoding::for_bom",
							"enc"
						]
					},
					"inputDataExample": "{\"slice\": \"[255, 254, 83, 0, 104, 0, 101, 0, 114, 0, 108, 0, 111, 0, 99, 0, 107, 0]\"}",
					"outputDataExample": "{\"needs_transcoding\": true, \"detected_encoding_from_bom\": \"UTF-16LE\"}"
				},
				{
					"simStepId": "ca819058-9cab-4aad-8f61-1b6ae3b048d4",
					"diagramNodeId": "e74e24ed-351c-4c12-97be-3415ebc9544d",
					"simStepLabel": "Transmit Bytes for Transcoding",
					"simStepDescription": "If transcoding is needed, the raw bytes are sent to a generic reader that uses the previously configured `DecodeReaderBytes` to perform the conversion from the source encoding (e.g., UTF-16LE) to UTF-8.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/searcher/src/searcher/mod.rs",
						"startLine": "782",
						"endLine": "785",
						"relevantVariables": [
							"self.slice_needs_transcoding",
							"self.search_reader"
						]
					},
					"inputDataExample": "{\"raw_bytes\": \"[255, 254, 83, 0, 104, 0, 101, 0, 114, 0, 108, 0, 111, 0, 99, 0, 107, 0]\"}",
					"outputDataExample": "{\"raw_bytes\": \"[255, 254, 83, 0, 104, 0, 101, 0, 114, 0, 108, 0, 111, 0, 99, 0, 107, 0]\"}"
				},
				{
					"simStepId": "6151f2ec-ed96-486d-88d4-5b8087febd55",
					"diagramNodeId": "99aa5944-d138-4a45-b6c4-f5aa605d648d",
					"simStepLabel": "Search Transcoded UTF-8 Data",
					"simStepDescription": "The matcher operates on the transcoded UTF-8 data. The core matching logic assumes it is working with UTF-8 (or at least ASCII-compatible) bytes, ensuring that patterns like `.` match Unicode codepoints correctly and the search yields accurate results.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/matcher/src/lib.rs",
						"startLine": "620",
						"endLine": "623",
						"relevantVariables": [
