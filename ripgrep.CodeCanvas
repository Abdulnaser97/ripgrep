		"Customize behavior with a persistent configuration file": {
			"name": "Customize behavior with a persistent configuration file",
			"simSteps": [
				{
					"simStepId": "53335fc8-21d3-427d-a0bc-065331dd8455",
					"diagramNodeId": "b74f4280-0b72-4063-9c21-580e6588b528",
					"simStepLabel": "Start Argument Parsing",
					"simStepDescription": "The application begins parsing command-line arguments. As part of this process, it checks whether it should load arguments from a configuration file before finalizing the configuration.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/parse.rs",
						"startLine": "89",
						"endLine": "91",
						"relevantVariables": [
							"low",
							"parser"
						]
					},
					"inputDataExample": "{\"command_line_args\": [\"rg\", \"Sherlock\", \"--context=2\"]}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "9c783d6b-041c-472b-8009-f9d7f05f409b",
					"diagramNodeId": "6cbb2324-9bba-4b03-9472-b8e0fdb05fec",
					"simStepLabel": "Invoke Configuration Loader",
					"simStepDescription": "The main argument parser calls the configuration module to load any arguments specified in a config file.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/parse.rs",
						"startLine": "94",
						"endLine": "94",
						"relevantVariables": [
							"config_args",
							"crate::flags::config::args"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "ee00687d-8740-4686-91dc-2c9b2d857807",
					"diagramNodeId": "356bd94f-a94b-4fd5-bcca-b70c7ca4635a",
					"simStepLabel": "Read RIPGREP_CONFIG_PATH Environment Variable",
					"simStepDescription": "The configuration module checks for the `RIPGREP_CONFIG_PATH` environment variable to find the path to the configuration file. If the variable is not set or is empty, the process stops here, and no arguments are loaded.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "15",
						"endLine": "21",
						"relevantVariables": [
							"config_path",
							"std::env::var_os"
						]
					},
					"inputDataExample": "{\"env_vars\": {\"RIPGREP_CONFIG_PATH\": \"/home/user/.ripgreprc\"}}",
					"outputDataExample": "{\"config_path\": \"/home/user/.ripgreprc\"}"
				},
				{
					"simStepId": "faaf3835-6ea8-4880-a5c8-c7d90cd5c161",
					"diagramNodeId": "7445db58-4de9-4bf1-959f-6ed9ee4ef0d7",
					"simStepLabel": "Pass Config Path to Parser",
					"simStepDescription": "The retrieved file path is passed to the internal parsing function to be opened and read.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "26",
						"endLine": "26",
						"relevantVariables": [
							"config_path",
							"parse"
						]
					},
					"inputDataExample": "{\"config_path\": \"/home/user/.ripgreprc\"}",
					"outputDataExample": "{\"config_path\": \"/home/user/.ripgreprc\"}"
				},
				{
					"simStepId": "5db838b5-8830-4636-bc22-193687d2fd6c",
					"diagramNodeId": "73cf577a-892c-43a8-b6e1-0d653047705b",
					"simStepLabel": "Open Config File",
					"simStepDescription": "The `parse` function attempts to open the file at the specified path. If successful, it passes the file handle to the `parse_reader` function.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "61",
						"endLine": "63",
						"relevantVariables": [
							"path",
							"file",
							"std::fs::File::open",
							"parse_reader"
						]
					},
					"inputDataExample": "{\"path\": \"/home/user/.ripgreprc\"}",
					"outputDataExample": "{\"file_handle\": \"<FileHandle for /home/user/.ripgreprc>\"}"
				},
				{
					"simStepId": "dce19a2f-ac20-4bb6-8ce0-8150f674a79e",
					"diagramNodeId": "895367ac-aa01-4097-9268-ba1818a71fe2",
					"simStepLabel": "Stream File Content",
					"simStepDescription": "The raw content of the configuration file is streamed to the `parse_reader` function for processing.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "78",
						"endLine": "80",
						"relevantVariables": [
							"rdr"
						]
					},
					"inputDataExample": "{\"file_content\": \"# Always use smart case searching\\n--smart-case\\n\\n# Show 3 lines of context\\n--context=3\"}",
					"outputDataExample": "{\"file_content\": \"# Always use smart case searching\\n--smart-case\\n\\n# Show 3 lines of context\\n--context=3\"}"
				},
				{
					"simStepId": "76df1817-4e07-4705-9977-511590839d2f",
					"diagramNodeId": "0d09f461-d956-4155-84dd-ac5b0d3fe32f",
					"simStepLabel": "Parse Lines into Arguments",
					"simStepDescription": "The `parse_reader` function reads the file line by line. It trims whitespace, ignores empty lines and lines starting with '#', and collects the remaining lines as individual string arguments.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "81",
						"endLine": "82",
						"relevantVariables": [
							"bufrdr",
							"args",
							"errs"
						]
					},
					"inputDataExample": "{\"file_content_lines\": [\"# Always use smart case searching\", \"--smart-case\", \"\", \"# Show 3 lines of context\", \"--context=3\"]}",
					"outputDataExample": "{\"args\": [\"--smart-case\", \"--context=3\"]}"
				},
				{
					"simStepId": "1b335ae0-0b1c-4f7f-b5b1-acc877020cfd",
					"diagramNodeId": "3a8581e6-7090-48fe-ac3d-9c9e277ad131",
					"simStepLabel": "Return Parsed Arguments",
					"simStepDescription": "The vector of arguments parsed from the configuration file is returned to the main argument parsing logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/config.rs",
						"startLine": "26",
						"endLine": "27",
						"relevantVariables": [
							"args",
							"errs"
						]
					},
					"inputDataExample": "{\"args\": [\"--smart-case\", \"--context=3\"], \"errs\": []}",
					"outputDataExample": "{\"args\": [\"--smart-case\", \"--context=3\"], \"errs\": []}"
				},
				{
					"simStepId": "2eab94ba-9641-43cb-812f-ad2707e994f2",
					"diagramNodeId": "02ebf40d-232a-4dc2-814a-9384bee8b86c",
					"simStepLabel": "Combine Config and CLI Arguments",
					"simStepDescription": "The arguments from the configuration file are prepended to the arguments that were passed directly on the command line. This allows CLI arguments to override settings from the config file if necessary (depending on the argument parser's behavior).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/parse.rs",
						"startLine": "101",
						"endLine": "102",
						"relevantVariables": [
							"final_args",
							"config_args"
						]
					},
					"inputDataExample": "{\"config_args\": [\"--smart-case\", \"--context=3\"], \"cli_args\": [\"Sherlock\", \"--context=2\"]}",
					"outputDataExample": "{\"final_args\": [\"--smart-case\", \"--context=3\", \"Sherlock\", \"--context=2\"]}"
				},
				{
					"simStepId": "f430c5a5-a5b6-4ef9-bba9-428a525473b0",
					"diagramNodeId": "9252420b-60b5-4c4a-9caf-c21360ce6363",
					"simStepLabel": "Pass Final Arguments to Parser",
					"simStepDescription": "The final, combined list of arguments is passed to the core argument parsing engine.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/parse.rs",
						"startLine": "105",
						"endLine": "105",
						"relevantVariables": [
							"parser",
							"final_args",
							"low"
						]
					},
					"inputDataExample": "{\"final_args\": [\"--smart-case\", \"--context=3\", \"Sherlock\", \"--context=2\"]}",
					"outputDataExample": "{\"final_args\": [\"--smart-case\", \"--context=3\", \"Sherlock\", \"--context=2\"]}"
				},
				{
					"simStepId": "515d1804-15f1-40e3-90a1-d5989c4dee95",
					"diagramNodeId": "3847c1e0-1d3f-4b44-9368-c809b22d3c07",
					"simStepLabel": "Finalize Application Configuration",
					"simStepDescription": "The argument parser processes the complete list of arguments, creating the final runtime configuration that will be used for the search operation. In this example, `smart-case` would be enabled, and the context would be set to 2 (as the CLI argument overrides the one from the config file).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/flags/parse.rs",
						"startLine": "105",
						"endLine": "107",
						"relevantVariables": [
							"parser",
							"final_args",
							"low"
						]
					},
					"inputDataExample": "{\"final_args\": [\"--smart-case\", \"--context=3\", \"Sherlock\", \"--context=2\"]}",
					"outputDataExample": "{\"final_configuration\": {\"smart_case\": true, \"context\": 2, \"pattern\": \"Sherlock\"}}"
				}
			],
			"description": "<ul><li>- Set default flags and options in a configuration file to avoid typing them repeatedly</li><li>- ripgrep reads arguments from the file specified by the <code>RIPGREP_CONFIG_PATH</code> environment variable</li><li>- Each line in the file is treated as a single command-line argument</li><li>- The parsing logic resides in <code>crates/core/flags/config</li><li>rs</code>, allowing for consistent and personalized search settings</li></ul>",
			"simulationNodesAndEdges": {
