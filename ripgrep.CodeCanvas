					"diagramNodeId": "fee953b3-dffd-4d29-ad76-fea8b03638cc",
					"simStepLabel": "Initiate Parallel Search",
					"simStepDescription": "The main function, having parsed command-line arguments, determines that a parallel search is required. It constructs a parallel directory walker which respects ignore files (.gitignore, .ignore). The walker is configured to run on a thread pool.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "crates/core/main.rs",
						"startLine": "180",
						"endLine": "180",
						"relevantVariables": [
