					},
					"inputDataExample": "{\n  \"types_builder\": \"Configured with user selections and definitions\"\n}",
					"outputDataExample": "{\n  \"types_builder\": \"Configured with user selections and definitions\"\n}"
				},
				{
					"simStepId": "1ad53294-cb57-4125-8eb7-ed18c5df7b68",
					"diagramNodeId": "0cbb420c-a59b-4509-87bc-460aca72c0a8",
					"simStepLabel": "Compile Globs for Selected File Types",
					"simStepDescription": "The `TypesBuilder::build` method resolves all selected and negated file type names to their corresponding glob patterns. It then compiles all of these globs into a single, efficient `GlobSet` that will be part of the final `Types` matcher object.",
					"isEdge": 0,
